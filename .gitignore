# Sensitive credential files (prevent accidental commits)
group_vars/**/credentials.yml
host_vars/**/credentials.yml
**/credentials.yml
!**/credentials.yml.example

# GitHub Copilot local configuration (not tracked)
.github/copilot/
.github/instructions/
.github/prompts/
.github/chatmodes/
.github/copilot-instructions.md

# Claude AI local configuration (not tracked)
.claude/

# Ansible files
.ansible/

# Ansible retry files
*.retry

# Logs and temporary files
*.log
logs/
*.tmp
*.temp

# Python cache and virtual environments
__pycache__/
*.py[cod]
*$py.class
.Python
*.so
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# Molecule test artifacts
.molecule/
molecule/**/.cache/

# AAP/Tower artifacts
.tower_cli.cfg

# Ansible collections cache
collections/ansible_collections/

# Private/local development files
local/
private/
.local/
*.local

# OS-specific files
Thumbs.db
desktop.ini

# Backup files
*.bak
*.backup
*~

# Ansible Galaxy artifacts
*.tar.gz